# Host-side configuration for the Lightspeed Harbor adapter.
# Copy to .env (gitignored) or export in the shell that runs Harbor.
# None of these values is ever inserted into a task sandbox except the
# registration key, which is written to a mode-0600 file and deleted once
# the registration receipt appears.

# Lightspeed JSON-RPC endpoint, normally ending in /rpc.
LIGHTSPEED_API_URL=

# Bearer key for an api-key mode gateway. Authorizes session control in the
# evaluation universe. Stays on the Harbor host.
LIGHTSPEED_API_KEY=

# Registration key minted with environments/registration-keys/create for the
# evaluation universe: ephemeral identity mode, active limit just above Harbor
# concurrency, campaign expiry. Rotate between campaigns.
LIGHTSPEED_HARBOR_REGISTRATION_KEY=

# Public connect route envd dials from inside the sandbox.
# wss://<host>/environment-gateway/connect (ws:// only toward loopback)
LIGHTSPEED_ENVD_GATEWAY_URL=

# Optional PEM bundle of extra TLS trust anchors, uploaded into the sandbox
# and passed to envd as LIGHTSPEED_ENVD_CA_FILE. Needed for a gateway behind a
# private CA, including the local TLS terminator from scripts/local-gateway-tls.sh.
LIGHTSPEED_HARBOR_ENVD_CA_FILE=

# Optional development and release overrides.
# Local lightspeed-envd binary to upload instead of a pinned release artifact.
# Build one in the sibling checkout: cargo build -p environment-daemon --release
LIGHTSPEED_HARBOR_ENVD_PATH=
# Pinned release artifact plus checksum for release runs.
LIGHTSPEED_HARBOR_ENVD_RELEASE_URL=
LIGHTSPEED_HARBOR_ENVD_SHA256=
LIGHTSPEED_HARBOR_ENVD_VERSION=
# With neither a path nor a release URL, the adapter reads the deployment's
# discovery document (default: <api origin>/.well-known/lightspeed-envd),
# downloads the archive for the sandbox architecture, verifies its checksum,
# and refuses a daemon whose build differs from the server's `initialize`
# gitSha. Development only: LIGHTSPEED_HARBOR_ENVD_ALLOW_MISMATCH=1.
LIGHTSPEED_HARBOR_ENVD_DISCOVERY_URL=

# Session metadata `campaign` (the run scripts default it to the job name) and
# automatic deletion of evaluation sessions after close, in seconds
# (default 14 days; 0 keeps them until deleted by hand).
LIGHTSPEED_HARBOR_CAMPAIGN=
LIGHTSPEED_HARBOR_SESSION_TTL_SEC=

# Universe id sent as x-lightspeed-universe to a trusted-header gateway, such
# as the `./dev.sh` full profile. Leave unset for api-key and single modes,
# which reject the header.
LIGHTSPEED_UNIVERSE=

# --- Local stack (../lightspeed `./dev.sh runtime`, auth mode `single`) ---
# The single-mode gateway ignores the bearer header, so any placeholder works:
#   LIGHTSPEED_API_URL=http://127.0.0.1:18080/rpc
#   LIGHTSPEED_API_KEY=local
# With the `full` profile (trusted-header) also set LIGHTSPEED_UNIVERSE to the
# universe id the Platform uses.
#   LIGHTSPEED_HARBOR_REGISTRATION_KEY=<from: lightspeed env registration-keys create --identity-mode ephemeral ...>
# Sandboxes cannot reach the host's loopback and envd refuses plain ws:// off
# loopback, so terminate TLS with scripts/local-gateway-tls.sh and export the
# two lines it prints (gateway URL on host.docker.internal:18443 plus CA file).
# Build a sandbox-architecture envd with scripts/build-envd-linux.sh and point
# LIGHTSPEED_HARBOR_ENVD_PATH at it.

# --- Hosted Lightspeed (ls.bot) -------------------------------------------
# Operator hand-off, kept in the gitignored .local/hosted.env and read by
# scripts/run-hosted.sh. The operator creates the evaluation universe and its
# API key on hz01 (operator/universes/create, infra/scripts/api-key create);
# the benchmark tooling mints its own per-campaign registration keys through
# the public api-key RPC with that key.
#   LIGHTSPEED_API_URL=https://ls.bot/rpc
#   LIGHTSPEED_API_KEY=lsk_...
#   LS_UNIVERSE_ID=<evaluation universe uuid>
#   LS_API_KEY_PREFIX=lsk_xxxxxxxx           # provenance only
#   LIGHTSPEED_ENVD_GATEWAY_URL=wss://ls.bot/environment-gateway/connect
# The envd binary must be built from the deployed release commit
# (/var/lib/ls-deploy/last-good.env on hz01); run-hosted.sh checks that.
