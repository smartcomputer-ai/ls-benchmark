# Host-side configuration for the Lightspeed Harbor adapter.
# Copy to .env (gitignored) or export in the shell that runs Harbor.
# None of these values is ever inserted into a task sandbox except the
# registration key, which is written to a mode-0600 file and deleted once
# the registration receipt appears.

# Lightspeed JSON-RPC endpoint, normally ending in /rpc.
LIGHTSPEED_API_URL=

# Bearer key for an api-key mode gateway. Authorizes session control in the
# evaluation universe. Stays on the Harbor host.
LIGHTSPEED_API_KEY=

# Registration key minted with environments/registration-keys/create for the
# evaluation universe: ephemeral identity mode, active limit just above Harbor
# concurrency, campaign expiry. Rotate between campaigns.
LIGHTSPEED_HARBOR_REGISTRATION_KEY=

# Public connect route envd dials from inside the sandbox.
# wss://<host>/environment-gateway/connect (ws:// only toward loopback)
LIGHTSPEED_ENVD_GATEWAY_URL=

# Optional development and release overrides.
# Local lightspeed-envd binary to upload instead of a pinned release artifact.
# Build one in the sibling checkout: cargo build -p environment-daemon --release
LIGHTSPEED_HARBOR_ENVD_PATH=
# Pinned release artifact plus checksum for release runs.
LIGHTSPEED_HARBOR_ENVD_RELEASE_URL=
LIGHTSPEED_HARBOR_ENVD_SHA256=
LIGHTSPEED_HARBOR_ENVD_VERSION=
